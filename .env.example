# Telegram
TELEGRAM_TOKEN=<Telegram token id>
TELEGRAM_CHAT_ID=<Telegram chat id>

# MQTT
MQTT_BROKER_URL=mqtt://mosquitto:1883 

# Camera
SNAPSHOT_URL=http://<esp32-camera-ip>/capture
SNAPSHOT_TIMEOUT_MS=5000

# API
API_PORT=3001

# Zigbee Gateway Path 
ZIGBEE_GATEWAY_PATH=/dev/ttyUSB0 

# Frontend
API_PROXY_TARGET=http://<host-ip>:3001 # The URL of the backend API, used for proxying API requests during development. In production, this should point to the actual backend service URL.
