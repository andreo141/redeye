# Telegram
TELEGRAM_TOKEN= # Your Telegram bot token, obtained from BotFather
TELEGRAM_CHAT_ID= # Your Telegram chat ID, where you want to receive alerts (can be a group or individual chat)

# MQTT
MQTT_BROKER_URL=mqtt://mosquitto:1883 

# Camera
SNAPSHOT_URL=http://<esp32-camera-ip>/capture
SNAPSHOT_TIMEOUT_MS=5000

# API
API_PORT=3001